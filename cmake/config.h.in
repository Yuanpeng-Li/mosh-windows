/* src/include/config.h -- generated by CMake.
 *
 * This mirrors what autotools' autoheader produces, so that the existing
 * sources compile unchanged under either build system. Keep the macro names
 * identical to configure.ac's AC_DEFINEs; the code greps for these exact
 * spellings.
 *
 * Autotools writes its own src/include/config.h.in; this file is deliberately
 * named differently and lives under cmake/ so the two never collide.
 */

#ifndef MOSH_CONFIG_H
#define MOSH_CONFIG_H

/* ---------------------------------------------------------------- package */
#define PACKAGE "@PACKAGE@"
#define PACKAGE_NAME "@PACKAGE_NAME@"
#define PACKAGE_TARNAME "@PACKAGE_TARNAME@"
#define PACKAGE_VERSION "@PACKAGE_VERSION@"
#define PACKAGE_STRING "@PACKAGE_STRING@"
#define PACKAGE_BUGREPORT "@PACKAGE_BUGREPORT@"
#define PACKAGE_URL "@PACKAGE_URL@"
#define VERSION "@PACKAGE_VERSION@"

/* ---------------------------------------------------------------- headers */
#cmakedefine HAVE_FCNTL_H 1
#cmakedefine HAVE_INTTYPES_H 1
#cmakedefine HAVE_LANGINFO_H 1
#cmakedefine HAVE_LIMITS_H 1
#cmakedefine HAVE_LOCALE_H 1
#cmakedefine HAVE_NETDB_H 1
#cmakedefine HAVE_NETINET_IN_H 1
#cmakedefine HAVE_PATHS_H 1
#cmakedefine HAVE_PTY_H 1
#cmakedefine HAVE_STDDEF_H 1
#cmakedefine HAVE_STDINT_H 1
#cmakedefine HAVE_STDIO_H 1
#cmakedefine HAVE_STDLIB_H 1
#cmakedefine HAVE_STRINGS_H 1
#cmakedefine HAVE_STRING_H 1
#cmakedefine HAVE_SYS_IOCTL_H 1
#cmakedefine HAVE_SYS_RANDOM_H 1
#cmakedefine HAVE_SYS_RESOURCE_H 1
#cmakedefine HAVE_SYS_SOCKET_H 1
#cmakedefine HAVE_SYS_STAT_H 1
#cmakedefine HAVE_SYS_TIME_H 1
#cmakedefine HAVE_SYS_TYPES_H 1
#cmakedefine HAVE_SYS_UIO_H 1
#cmakedefine HAVE_SYSLOG_H 1
#cmakedefine HAVE_TERMIOS_H 1
#cmakedefine HAVE_TERMIO_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine HAVE_UTMPX_H 1
#cmakedefine HAVE_UTIL_H 1
#cmakedefine HAVE_LIBUTIL_H 1
#cmakedefine HAVE_WCHAR_H 1
#cmakedefine HAVE_WCTYPE_H 1
#cmakedefine HAVE_ENDIAN_H 1
#cmakedefine HAVE_SYS_ENDIAN_H 1
#cmakedefine HAVE_COMMONCRYPTO_COMMONCRYPTO_H 1
#cmakedefine STDC_HEADERS 1

/* C++ headers */
#cmakedefine HAVE_MEMORY 1
#cmakedefine HAVE_TR1_MEMORY 1
#cmakedefine HAVE_STD_SHARED_PTR 1
#cmakedefine HAVE_STD_TR1_SHARED_PTR 1
#cmakedefine HAVE_CXX17 1

/* -------------------------------------------------------------- functions */
#cmakedefine HAVE_CFMAKERAW 1
#cmakedefine HAVE_CLOCK_GETTIME 1
#cmakedefine HAVE_GETTIMEOFDAY 1
#cmakedefine HAVE_GETENTROPY 1
#cmakedefine HAVE_GETRANDOM 1
#cmakedefine HAVE_MACH_ABSOLUTE_TIME 1
#cmakedefine HAVE_PLEDGE 1
#cmakedefine HAVE_POSIX_MEMALIGN 1
#cmakedefine HAVE_PSELECT 1
#cmakedefine HAVE_FORKPTY 1
#cmakedefine FORKPTY_IN_LIBUTIL 1
#cmakedefine HAVE_UTEMPTER 1

/* ------------------------------------------------------ declarations (0/1) */
/* AC_CHECK_DECLS defines these to 1 or 0 -- never leaves them undefined. */
#define HAVE_DECL_BE64TOH @HAVE_DECL_BE64TOH@
#define HAVE_DECL_BETOH64 @HAVE_DECL_BETOH64@
#define HAVE_DECL_BSWAP64 @HAVE_DECL_BSWAP64@
#define HAVE_DECL_FFS @HAVE_DECL_FFS@
#define HAVE_DECL___BUILTIN_BSWAP64 @HAVE_DECL___BUILTIN_BSWAP64@
#define HAVE_DECL___BUILTIN_CTZ @HAVE_DECL___BUILTIN_CTZ@
#cmakedefine HAVE_OSX_SWAP 1

/* ---------------------------------------------------------------- symbols */
#cmakedefine HAVE_IUTF8 1
#cmakedefine HAVE_IP_MTU_DISCOVER 1
#cmakedefine HAVE_IP_RECVTOS 1
#cmakedefine FD_ISSET_IS_CONST 1

/* ----------------------------------------------------------------- curses */
#cmakedefine HAVE_CURSES_H 1
#cmakedefine HAVE_NCURSES_H 1
#cmakedefine HAVE_NCURSESW_H 1
#cmakedefine HAVE_NCURSES_CURSES_H 1
#cmakedefine HAVE_NCURSESW_CURSES_H 1
#cmakedefine HAVE_CURSES 1
#cmakedefine HAVE_NCURSES 1
#cmakedefine HAVE_NCURSESW 1
#cmakedefine HAVE_TINFO 1
#cmakedefine HAVE_CURSES_COLOR 1
#cmakedefine HAVE_CURSES_ENHANCED 1
#cmakedefine HAVE_CURSES_OBSOLETE 1

/* ----------------------------------------------------------------- crypto */
#cmakedefine USE_OPENSSL_AES 1
#cmakedefine USE_NETTLE_AES 1
#cmakedefine USE_APPLE_COMMON_CRYPTO_AES 1

/* ------------------------------------------------------------------ other */
#cmakedefine HAVE_SYSLOG 1
#cmakedefine HAVE_UINTPTR_T 1

/* autoconf defines `restrict` to an empty expansion when the compiler has no
   support for it. Both gcc/clang and MSVC accept a spelling of __restrict, so
   define it to that instead. C++ has no `restrict` keyword, hence the guard. */
#ifndef __cplusplus
#cmakedefine restrict @MOSH_RESTRICT@
#endif

/* ---------------------------------------------------------------- Windows */
/* Not produced by autotools; set only by the CMake build on Win32 so the
   platform layer can branch without sprinkling _WIN32 checks everywhere. */
#cmakedefine MOSH_PLATFORM_WIN32 1
#cmakedefine MOSH_PLATFORM_POSIX 1

#endif /* MOSH_CONFIG_H */
