#!/bin/sh

#
# This is a regression test to ensure that Mosh does not spin
# on updates that do not actually change the framebuffer.
#

# shellcheck source=e2e-test-subrs
. "$(dirname "$0")/e2e-test-subrs"
PATH=$PATH:.:$srcdir
# Top-level wrapper.
if [ $# -eq 0 ]; then
    e2e-test "$0" baseline post
    exit
fi

# OK, we have arguments, we're one of the test hooks.
if [ $# -ne 1 ]; then
    fail "bad arguments %s\n" "$@"
fi

baseline()
{
    # Generate updates that don't change the screen
    i=0
    while [ $i -lt 10 ] && printf 'x\b' && sleep 1; do
	i=$((i + 1))
    done
}

post()
{
    # Read ps directly from the harness: tmux can split a marker across
    # output records. Darwin reports M:SS.hh; Linux uses [D-]HH:MM:SS.
    file="$(basename "$0").d/baseline.cputime"
    LC_ALL=C awk '
        NR == 1 && NF == 1 && $1 == "-" { unsupported = 1; next }
        NR == 1 && NF == 1 && $1 ~ /^([0-9]+-)?([0-9]+:)?[0-9]+:[0-9]+([.][0-9]+)?$/ {
            measured = $1
            n = split($1, parts, /[-:]/)
            for (i = 1; i <= n; ++i) if (parts[i] + 0 >= 1) over_limit = 1
        }
        END {
            if (NR == 1 && unsupported) { print "ps cannot report server CPU time"; exit 77 }
            if (NR != 1 || !length(measured)) { print "Invalid server CPU time in " FILENAME; exit 99 }
            if (over_limit) { print "Server used " measured " CPU time (limit: 1 second)"; exit 1 }
        }
    ' "$file"
}

case $1 in
    baseline)
	baseline;;
    post)
	post;;
    *)
	fail "unknown test argument %s\n" "$1";;
esac
