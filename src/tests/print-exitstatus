#!/usr/bin/env perl

#
# Record the wrapped command's status before tmux closes the pane.
#
use warnings;
use strict;

my $rc = system(@ARGV);
if ($? == -1) {
    die "system failed: $!\n";
}
if ($? == 0) {
    $rc = 0;
} elsif ($? >= 256) {
    $rc = $? >> 8;
} else {
    $rc = ($? & 127) | 128;
}
my $path = $ENV{'MOSH_E2E_TEST'} . ".client.exitstatus";
open(my $status, ">", $path) or die "open $path: $!";
print {$status} "$rc\n" or die "write $path: $!";
close($status) or die "close $path: $!";
exit $rc;
